GROQ_API_KEY=gsk_your_api_key_here
ALLOWED_ORIGINS=*

# Groq chat models — https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Job-match ranking tries these in order (skip if removed / rate-limited):
# GROQ_MATCH_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# LinkedIn job matches (Matches tab) — Agent-Reach style backends
# Primary: MCP HTTP endpoint after logging in with a dedicated LinkedIn account
# LINKEDIN_MCP_URL=http://localhost:8001
# Optional JSON bridge wrapping search_jobs:
# LINKEDIN_MCP_BRIDGE_URL=http://localhost:8002
# Skip mcporter CLI path:
# LINKEDIN_DISABLE_MCPORTER=true

# Fallback: Jina Reader for public LinkedIn job search pages
JINA_READER_PREFIX=https://r.jina.ai/

# Adzuna Jobs API (free developer key) — used when LinkedIn backends fail
# Register at https://developer.adzuna.com/
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Optional default country code (gb, us, de, fr, …)
# ADZUNA_COUNTRY=gb

# Arbeitnow is used automatically as a free no-key fallback (EU / remote lean).
